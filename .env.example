# Earth Information Jukebox - Environment Configuration
# Copy this file to .env and adjust values as needed

# ─────────────────────────────────────────────────────────────
# Image Tags
# ─────────────────────────────────────────────────────────────
# Version tag for webapp and backend images (matches Git tags)
TAG=latest

# Version tag for datasets image (may differ from app versions)
DATA_TAG=latest

# ─────────────────────────────────────────────────────────────
# Port Configuration
# ─────────────────────────────────────────────────────────────
# Public-facing port for the webapp (default: 80)
WEBAPP_PORT=80

# Backend API port (default: 8000, usually only internal)
BACKEND_PORT=8000

# ─────────────────────────────────────────────────────────────
# Security Configuration
# ─────────────────────────────────────────────────────────────
# CORS allowed origins (comma-separated)
# Development: *
# Production: https://your-domain.com
JUKEBOX_CORS=*
