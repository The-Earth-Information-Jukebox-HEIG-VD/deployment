# Earth Information Jukebox - Environment Configuration
# Copy this file to .env and adjust values as needed

# ─────────────────────────────────────────────────────────────
# Image Tags
# ─────────────────────────────────────────────────────────────
# One version per image = the repository's Git tag WITHOUT the "v"
# (git tag v1.1.0 -> image 1.1.0), or "latest". Pin all three in production.
# CI publishes 1.1.0, 1.1 and latest; "v1.1.0" does not exist on GHCR and
# fails with "manifest unknown" (or "unauthorized" if the package is private).
# (Older .env files with TAG / DATA_TAG still work as fallbacks.)
WEBAPP_VERSION=latest          # ghcr.io/.../webapp
SONIFICATION_VERSION=latest    # ghcr.io/.../sonification (backend)
DATASETS_VERSION=latest        # ghcr.io/.../datasets (data volume)

# ─────────────────────────────────────────────────────────────
# Port Configuration
# ─────────────────────────────────────────────────────────────
# Public-facing port for the webapp (default: 80)
WEBAPP_PORT=80

# Backend API port (default: 8000, usually only internal)
BACKEND_PORT=8000

# ─────────────────────────────────────────────────────────────
# Security Configuration
# ─────────────────────────────────────────────────────────────
# CORS allowed origins (comma-separated), used by docker-compose.yml (dev)
JUKEBOX_CORS=*

# ─────────────────────────────────────────────────────────────
# Production (docker-compose.prod.yml, Traefik + Let's Encrypt)
# ─────────────────────────────────────────────────────────────
# Domain the stack is served on. Point DNS for all three names at the server:
#   https://DOMAIN        webapp
#   https://www.DOMAIN    redirects to https://DOMAIN
#   https://api.DOMAIN    backend API
DOMAIN=example.com

# Email Let's Encrypt uses for certificate expiry notices
ACME_EMAIL=admin@example.com

# Traefik image tag
TRAEFIK_VERSION=v3.6

# Optional: CORS origins for the backend in production.
# Default: https://DOMAIN,https://www.DOMAIN
# JUKEBOX_CORS_PROD=https://example.com,https://www.example.com

# ─────────────────────────────────────────────────────────────
# Webapp Build (REQUIRED for local builds: docker-compose.local.yml)
# ─────────────────────────────────────────────────────────────
# Base URL the browser uses to call the API. Baked into the JS bundle
# when the webapp image is built (the Dockerfile writes it to .env).
#   /api  same origin, nginx proxies /api/* to the backend (recommended)
# Images pulled from GHCR are built by CI with VITE_API_URL=/api.
VITE_API_URL=/api
